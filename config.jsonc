// ~/.config/fastfetch/config.jsonc
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "none",
    "padding": {
      "top": 1
    }
  },

  "display": {
    "separator": " -> ",
    "color": {
      "keys": "white"
    }
  },

  "keyWidth": 10,

  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "os",
      "key": "distro",
      "format": "{name} {version}"
    },
    {
      "type": "kernel",
      "key": "kernel",
      "format": "{release}"
    },
    {
      "type": "cpu",
      "key": "cpu",
    },
    {
      "type": "gpu",
      "key": "gpu",
      "hideType": "integrated"
    },
    {
      "type": "packages",
      "key": "pkgs"
    },
    {
      "type": "shell",
      "key": "shell"
    },
    {
      "type": "wm",
      "key": "wm"
    },
    {
      "type": "memory",
      "key": "ram"
    },
    {
      "type": "disk",
      "key": "disk"
    }
  ]
}
